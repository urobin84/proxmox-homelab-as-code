# =============================================================================
# Loki Config - single binary, storage filesystem lokal (LXC 106)
# =============================================================================
auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096
  log_level: warn

common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

# Schema penyimpanan log
schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

# Kompaksi + hapus log lama otomatis (hemat disk)
compactor:
  working_directory: /loki/compactor
  compaction_interval: 10m
  retention_enabled: true
  retention_delete_delay: 2h
  delete_request_store: filesystem

# Batas penggunaan resource (penting untuk homelab)
limits_config:
  retention_period: {{ loki_retention_period }}
  ingestion_rate_mb: 4
  ingestion_burst_size_mb: 8
  max_streams_per_user: 5000
  max_entries_limit_per_query: 5000
  split_queries_by_interval: 24h

# Query cache kecil di RAM
query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 50

analytics:
  reporting_enabled: false
