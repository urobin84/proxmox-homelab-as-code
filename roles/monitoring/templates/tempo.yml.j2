# =============================================================================
# Tempo Config - single binary, storage lokal (LXC 106)
# =============================================================================
stream_over_http_enabled: true
server:
  http_listen_port: 3200
  log_level: warn

# Distributor - terima trace OTLP dari Alloy (LXC 101)
distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: "0.0.0.0:4317"
        http:
          endpoint: "0.0.0.0:4318"

# Ingester
ingester:
  trace_idle_period: 10s
  max_block_bytes: 1_000_000   # 1MB per block (hemat RAM)
  max_block_duration: 5m

# Storage lokal (tidak ke S3/GCS - homelab friendly)
storage:
  trace:
    backend: local
    wal:
      path: /var/tempo/wal
    local:
      path: /var/tempo/blocks

# Kompaksi & retensi
compactor:
  compaction:
    block_retention: {{ tempo_retention_period }}

querier:
  max_concurrent_queries: 5

usage_report:
  reporting_enabled: false
{% if tempo_metrics_generator_enabled %}

# Metrics generator (service graph + RED metrics → Prometheus)
metrics_generator:
  registry:
    external_labels:
      source: tempo
      cluster: proxmox-homelab
  storage:
    path: /var/tempo/generator/wal
    remote_write:
      - url: http://prometheus:9090/api/v1/write
        send_exemplars: true

overrides:
  defaults:
    metrics_generator:
      processors:
        - service-graphs
        - span-metrics
{% endif %}
