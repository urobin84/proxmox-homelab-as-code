{
  "uid": "homelab-overview",
  "title": "Homelab Overview",
  "id": null,
  "description": "Ringkasan homelab Proxmox: host, uptime, alert, backup, kapasitas, keamanan. Dikelola Ansible - perubahan di UI tidak permanen.",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Node Exporter Full",
      "type": "link",
      "url": "/d/node-exporter-full"
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/d/postgresql"
    },
    {
      "title": "Blackbox",
      "type": "link",
      "url": "/d/blackbox-http"
    }
  ],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Ringkasan",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
