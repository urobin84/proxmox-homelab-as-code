#!/usr/bin/env bash
# =============================================================================
# homelab-offsite.sh - salin backup vzdump TERBARU per LXC ke Google Drive
# TERENKRIPSI via rclone crypt ({{ offsite_crypt_remote_name }}: → {{ offsite_crypt_target }})
# Dikelola Ansible (role proxmox_backup) - dijalankan homelab-offsite.timer
# Log: journalctl -u homelab-offsite.service
#
# Restore dari Google Drive:
#   rclone lsl {{ offsite_rclone_remote }}
#   rclone copy {{ offsite_rclone_remote }}/<file>.tar.zst {{ proxmox_backup_storage_path }}/dump/
#   lalu restore dari storage {{ proxmox_backup_storage }} di Web UI
# =============================================================================
set -euo pipefail

SRC="{{ proxmox_backup_storage_path }}/dump"
DEST="{{ offsite_rclone_remote }}"
REMOTE="{{ offsite_base_remote }}"   # kuota dicek di remote Drive asli
BWLIMIT="{{ offsite_bwlimit }}"
RETENTION="{{ offsite_retention }}"
MIN_FREE=$(( {{ offsite_min_free_gb }} * 1024 * 1024 * 1024 ))

# HDD tidak ter-mount = folder kosong di disk sistem; jangan lanjut
if ! mountpoint -q "{{ proxmox_backup_storage_path }}"; then
    echo "ERROR: {{ proxmox_backup_storage_path }} tidak ter-mount" >&2
    exit 1
fi

# Kumpulkan backup terbaru per LXC (+ file .log dan .notes)
LIST=$(mktemp)
trap 'rm -f "$LIST"' EXIT
total=0
for id in $(pct list | awk 'NR>1 {print $1}'); do
    newest=$(ls -1t "$SRC"/vzdump-lxc-"$id"-*.tar.zst 2>/dev/null | head -n1 || true)
    [ -n "$newest" ] || { echo "SKIP: belum ada backup untuk LXC $id"; continue; }
    name=$(basename "$newest")
    echo "$name" >> "$LIST"
    [ -f "$newest.notes" ] && echo "$name.notes" >> "$LIST"
    [ -f "${newest%.tar.zst}.log" ] && echo "${name%.tar.zst}.log" >> "$LIST"
    total=$(( total + $(stat -c %s "$newest") ))
done

if [ ! -s "$LIST" ]; then
    echo "Tidak ada backup untuk disalin"
    exit 0
fi

# Hapus dulu backup lama di GDrive agar ruang cukup
echo "Hapus backup di $DEST yang lebih tua dari $RETENTION"
rclone delete "$DEST" --min-age "$RETENTION" --include "vzdump-lxc-*"

free=$(rclone about "$REMOTE" --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["free"])')
echo "Ukuran upload: $(( total / 1024 / 1024 )) MiB | ruang kosong GDrive: $(( free / 1024 / 1024 )) MiB"
if [ $(( total + MIN_FREE )) -gt "$free" ]; then
    echo "ERROR: ruang Google Drive tidak cukup - upload dibatalkan" >&2
    exit 1
fi

# rclone copy melewati file yang sudah ada & identik
rclone copy "$SRC" "$DEST" --files-from "$LIST" --bwlimit "$BWLIMIT" --stats-one-line --stats 5m -v
echo "Offsite selesai: $(wc -l < "$LIST") file"

# Stamp sukses → metrics homelab_offsite_last_success_timestamp_seconds
mkdir -p "{{ homelab_state_dir | default('/var/lib/homelab') }}"
date +%s > "{{ homelab_state_dir | default('/var/lib/homelab') }}/offsite-last-success"
