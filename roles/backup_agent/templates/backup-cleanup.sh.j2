#!/usr/bin/env bash
# =============================================================================
# backup-cleanup.sh
# Sinkronisasi daftar file di Google Drive dan hapus yang sudah melebihi
# retention period. Dijalankan setiap hari jam 03:00 via cron.
# =============================================================================

set -euo pipefail

GDRIVE_REMOTE="{{ rclone_gdrive_remote_name }}:{{ rclone_gdrive_folder }}"
RETENTION_DAYS="{{ backup_retention_days }}"
LOG_PREFIX="[$(date '+%Y-%m-%d %H:%M:%S')]"

echo "${LOG_PREFIX} Membersihkan file Google Drive > ${RETENTION_DAYS} hari..."

rclone delete "${GDRIVE_REMOTE}" \
    --min-age "${RETENTION_DAYS}d" \
    --include "*.tar.gz" \
    --include "*.sql.gz" \
    --bwlimit "{{ rclone_bandwidth_limit }}" \
    --log-level INFO

echo "${LOG_PREFIX} Cleanup Google Drive selesai."
