# =============================================================================
# CONTOH secrets.yml - salin ke group_vars/all/secrets.yml, isi nilainya, lalu:
#   ansible-vault encrypt group_vars/all/secrets.yml
# Nilai acak kuat: openssl rand -base64 48 | tr -d "/+=\n" | cut -c1-40
# =============================================================================

# =============================================================================
# ANSIBLE VAULT - SECRETS
# Enkripsi file ini dengan: ansible-vault encrypt group_vars/all/secrets.yml
# Edit terenkripsi dengan  : ansible-vault edit group_vars/all/secrets.yml
# =============================================================================

# ---------------------------------------------------------------------------
# Database Credentials - PostgreSQL (DC-DATABASE: 192.168.100.x)
# ---------------------------------------------------------------------------
# PostgreSQL superuser (untuk membuat DB dan user baru)
db_postgres_password: "GANTI_DB_POSTGRES_PASSWORD"

# MQR
db_mqr_name: "GANTI_DB_MQR_NAME"
db_mqr_user: "GANTI_DB_MQR_USER"
db_mqr_password: "GANTI_DB_MQR_PASSWORD"
# Laravel DATABASE_URL (digunakan di .env)
mqr_database_url: "GANTI_MQR_DATABASE_URL"

# DKM
db_dkm_name: "GANTI_DB_DKM_NAME"
db_dkm_user: "GANTI_DB_DKM_USER"
db_dkm_password: "GANTI_DB_DKM_PASSWORD"
# Go Fiber / GORM DATABASE_URL
dkm_database_url: "GANTI_DKM_DATABASE_URL"

# DEV
db_dev_name: "GANTI_DB_DEV_NAME"
db_dev_user: "GANTI_DB_DEV_USER"
db_dev_password: "GANTI_DB_DEV_PASSWORD"
# Rust (SQLx / Diesel) DATABASE_URL
dev_database_url: "GANTI_DEV_DATABASE_URL"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
redis_password: "GANTI_REDIS_PASSWORD"

# ---------------------------------------------------------------------------
# MQR - Laravel
# ---------------------------------------------------------------------------
mqr_app_key: "GANTI_MQR_APP_KEY"
mqr_jwt_secret: "GANTI_MQR_JWT_SECRET"
mqr_nextjs_api_secret: "GANTI_MQR_NEXTJS_API_SECRET"

# ---------------------------------------------------------------------------
# DKM - Go Fiber + Vue 3
# ---------------------------------------------------------------------------
dkm_jwt_secret: "GANTI_DKM_JWT_SECRET"
dkm_api_key: "GANTI_DKM_API_KEY"

# ---------------------------------------------------------------------------
# DEV - Rust + Nuxt.js
# ---------------------------------------------------------------------------
dev_jwt_secret: "GANTI_DEV_JWT_SECRET"
dev_api_key: "GANTI_DEV_API_KEY"

# ---------------------------------------------------------------------------
# rclone / Google Drive (Backup Agent)
# ---------------------------------------------------------------------------
rclone_gdrive_remote_name: "GANTI_RCLONE_GDRIVE_REMOTE_NAME"
rclone_gdrive_client_id: "GANTI_RCLONE_GDRIVE_CLIENT_ID"
rclone_gdrive_client_secret: "GANTI_RCLONE_GDRIVE_CLIENT_SECRET"
rclone_gdrive_token: "GANTI_RCLONE_GDRIVE_TOKEN"

# ---------------------------------------------------------------------------
# SSH Keys (opsional, jika deploy via Ansible)
# ---------------------------------------------------------------------------
admin_ssh_public_key: "GANTI_ADMIN_SSH_PUBLIC_KEY"

# ---------------------------------------------------------------------------
# Grafana (LXC 106 - Monitoring)
# ---------------------------------------------------------------------------
grafana_admin_password: "GANTI_GRAFANA_ADMIN_PASSWORD"

# ---------------------------------------------------------------------------
# Enkripsi backup offsite (rclone crypt di host pve)
# PENTING: simpan salinan kedua nilai ini di password manager. Jika hilang,
#          backup di Google Drive TIDAK BISA didekripsi.
# ---------------------------------------------------------------------------
rclone_crypt_password: "GANTI_RCLONE_CRYPT_PASSWORD"
rclone_crypt_password2: "GANTI_RCLONE_CRYPT_PASSWORD2"

# ---------------------------------------------------------------------------
# Alert email (Alertmanager di LXC 106)
# ---------------------------------------------------------------------------
alert_email_to: "GANTI_ALERT_EMAIL_TO"
smtp_smarthost: "GANTI_SMTP_SMARTHOST"
smtp_username: "GANTI_SMTP_USERNAME"
smtp_password: "GANTI_SMTP_PASSWORD"

# ---------------------------------------------------------------------------
# PostgreSQL streaming replication (LXC 104 -> LXC 105)
# ---------------------------------------------------------------------------
pg_replication_password: "GANTI_PG_REPLICATION_PASSWORD"

# ---------------------------------------------------------------------------
# pgBackRest (PITR) - kunci enkripsi repositori backup AES-256
# WAJIB disalin ke password manager: tanpa kunci ini backup TIDAK BISA dipulihkan
# ---------------------------------------------------------------------------
pgbackrest_cipher_pass: "GANTI_PGBACKREST_CIPHER_PASS"
